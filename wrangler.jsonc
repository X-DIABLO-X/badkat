// Cloudflare Workers config for the badkat.cypherion.tech landing page.
//
// This exists because the deployment was serving the REPO ROOT, where
// index.html is the animation rig's demo stage — so the domain showed
// the "morphcat" dev page instead of the product landing page. Pointing
// the asset directory at ./site fixes that, and keeping it in the repo
// means the setting cannot drift out of a dashboard field again.
//
// The site is entirely static, so there is no Worker script: Cloudflare
// serves ./site directly.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "badkat",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./site",
    // every unknown path falls back to the single page rather than a
    // bare 404, so deep links and the in-page anchors keep working
    "not_found_handling": "single-page-application"
  }
}
